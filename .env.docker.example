APP_NAME=inYice-Lite
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://inyice.localhost
APP_DOMAIN=inyice.localhost

# Local dev port for web container (leave empty on VPS where Traefik routes internally)
APP_HTTP_PORT=8080

TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inyice
DB_USERNAME=inyice
DB_PASSWORD=inyice
DB_ROOT_PASSWORD=root

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120

API_RATE_LIMIT_PER_MINUTE=120
PUBLIC_API_RATE_LIMIT_PER_MINUTE=60
SENSITIVE_WRITE_RATE_LIMIT_PER_MINUTE=30
SIGNIN_RATE_LIMIT_PER_MINUTE=6
SIGNUP_RATE_LIMIT_PER_MINUTE=5
RATE_LIMITER_USE_REDIS=true
TRUSTED_PROXIES=172.16.0.0/12

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Sanctum SPA auth — must match the domain the React app is served from
SANCTUM_STATEFUL_DOMAINS=inyice.localhost

# Vite build-time public URL (used by Laravel Vite plugin manifest)
VITE_APP_URL=https://inyice.localhost

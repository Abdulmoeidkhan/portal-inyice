APP_NAME="inYice OS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://os.inyice.com
APP_URI=https://os.inyice.com/api
APP_DOMAIN=os.inyice.com
APP_PORT=8081

COMPOSE_PROJECT_NAME=os-inyice

# Local-only fallback port when running without Traefik.
# On a shared VPS, prefer docker-compose.traefik.yml and keep any direct port unpublished.
APP_HTTP_PORT=8081
VITE_PORT=5174
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6380

TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inyice_os
DB_USERNAME=inyice_os
DB_PASSWORD=change_me_inyice_os_db_password
DB_ROOT_PASSWORD=change_me_mysql_root_password

CACHE_STORE=redis
CACHE_PREFIX=inyice_os
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=os.inyice.com
SESSION_SECURE_COOKIE=true

API_RATE_LIMIT_PER_MINUTE=120
PUBLIC_API_RATE_LIMIT_PER_MINUTE=60
SENSITIVE_WRITE_RATE_LIMIT_PER_MINUTE=30
SIGNIN_RATE_LIMIT_PER_MINUTE=6
SIGNUP_RATE_LIMIT_PER_MINUTE=5
RATE_LIMITER_USE_REDIS=true
TRUSTED_PROXIES=172.16.0.0/12

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Sanctum SPA auth — must match the domain the React app is served from
SANCTUM_STATEFUL_DOMAINS=os.inyice.com

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@inyice.com
MAIL_PASSWORD=change_me_hostinger_mail_password
MAIL_FROM_ADDRESS="no-reply@inyice.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vite build-time public URL (used by Laravel Vite plugin manifest)
VITE_APP_URL=https://os.inyice.com

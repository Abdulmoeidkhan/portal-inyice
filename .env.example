APP_NAME="inYice OS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://os.inyice.com
APP_URI=https://os.inyice.com/api
APP_DOMAIN=os.inyice.com
APP_PORT=8081
APP_HTTP_PORT=8081
VITE_PORT=5174
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6380

COMPOSE_PROJECT_NAME=inyice_os
APP_ENV_FILE=.env

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inyice_os
DB_USERNAME=inyice_os
DB_PASSWORD=change_me_inyice_os_db_password
DB_ROOT_PASSWORD=change_me_mysql_root_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=os.inyice.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=inyice_os

API_RATE_LIMIT_PER_MINUTE=120
PUBLIC_API_RATE_LIMIT_PER_MINUTE=60
SENSITIVE_WRITE_RATE_LIMIT_PER_MINUTE=30
SIGNIN_RATE_LIMIT_PER_MINUTE=6
SIGNUP_RATE_LIMIT_PER_MINUTE=5
RATE_LIMITER_USE_REDIS=true
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=os.inyice.com

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@inyice.com
MAIL_PASSWORD=change_me_hostinger_mail_password
MAIL_FROM_ADDRESS="no-reply@inyice.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
